{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "qwen3.5-plus": {
          "name": "Qwen 3.5 Plus"
        },
        "qwen3.6-plus": {
          "name": "Qwen 3.6 Plus"
        },
        "glm-5.1": {
          "name": "GLM 5.1"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6 (3x limits)"
        }
      }
    },
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen (free)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "minimax-m2.5-free": {
          "name": "MiniMax M2.5 Free"
        }
      }
    }
  },
  "agent": {
    "explorer": {
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.1,
      "description": "Repository discovery and contextual code exploration. Cheap, fast, large context."
    },
    "plan": {
      "model": "opencode-go/qwen3.6-plus",
      "temperature": 0.2,
      "description": "Architecture and execution planning. Strong reasoning."
    },
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.2,
      "description": "Implementation and code modification. Coding reliability."
    },
    "tester": {
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.2,
      "description": "Validation and testing analysis. Adversarial reasoning."
    },
    "teacher": {
      "model": "opencode-go/qwen3.6-plus",
      "temperature": 0.3,
      "description": "Conceptual understanding and technical education."
    }
  }
}
