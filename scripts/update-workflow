#!/usr/bin/env bash
# update-workflow — pull latest dotfiles from origin/main

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"

if [[ -t 1 ]]; then
  R=$'\033[0m'
  BOLD=$'\033[1m'
  GREEN=$'\033[32m'
  RED=$'\033[31m'
  BCYAN=$'\033[96m'
else
  R=''; BOLD=''; GREEN=''; RED=''; BCYAN=''
fi

log()    { printf "${BOLD}${BCYAN}  ◆${R}  ${BOLD}%s${R}\n" "$*"; }
ok()     { printf "${GREEN}  ✓${R}  %s\n" "$*"; }
err()    { printf "${RED}  ✗${R}  %s\n" "$*" >&2; }

log "Fetching latest from origin/main…"
if ! git -C "$DOTFILES" fetch origin; then
  err "Failed to fetch from origin."
  exit 1
fi

if ! git -C "$DOTFILES" merge --ff-only origin/main; then
  err "Cannot fast-forward to origin/main. Local commits may exist."
  exit 1
fi

ok "Dotfiles updated to latest origin/main."
