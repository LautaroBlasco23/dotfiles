#!/usr/bin/env bash
# claude-workflow — manage Claude Code workflow profiles
#
# Usage:
#   claude-workflow                    interactive menu
#   claude-workflow list               list available workflows
#   claude-workflow status             show active workflow summary
#   claude-workflow switch <name>      switch to a workflow
#   claude-workflow new <name>         scaffold a new workflow from the active one

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
WORKFLOWS_DIR="$DOTFILES/claude-workflows"
CLAUDE_DIR="$DOTFILES/claude"
ACTIVE_FILE="$WORKFLOWS_DIR/.active"

# ── styling ───────────────────────────────────────────────────────────────────

if [[ -t 1 ]]; then
  R=$'\033[0m'
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  CYAN=$'\033[36m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  RED=$'\033[31m'
  GRAY=$'\033[90m'
  BCYAN=$'\033[96m'
  BGREEN=$'\033[92m'
  BRED=$'\033[91m'
  BYELLOW=$'\033[93m'
else
  R=''; BOLD=''; DIM=''; CYAN=''; GREEN=''; YELLOW=''
  RED=''; GRAY=''; BCYAN=''; BGREEN=''; BRED=''; BYELLOW=''
fi

# Restore cursor on any exit (Ctrl-C, errors, etc.)
trap 'printf "\033[?25h" 2>/dev/null || true' EXIT

_hline() { printf '%*s' "${1:-46}" '' | tr ' ' '─'; }

# Print a box header: header "Title"
header() {
  local title="$1"
  local line; line=$(_hline 48)
  printf "\n${BOLD}${BCYAN}  ╭%s╮${R}\n" "$line"
  printf "${BOLD}${BCYAN}  │${R}  ${BOLD}%-46s${BCYAN}│${R}\n" "$title"
  printf "${BOLD}${BCYAN}  ╰%s╯${R}\n\n" "$line"
}

# Print a section separator: section "Label"
section() {
  local label="$1"
  local pad=$(( 40 - ${#label} ))
  [[ $pad -lt 1 ]] && pad=1
  local line; line=$(_hline "$pad")
  printf "\n${BOLD}${GRAY}  ─── %s %s${R}\n\n" "$label" "$line"
}

# Print a horizontal rule
rule() {
  printf "${GRAY}  %s${R}\n" "$(_hline 48)"
}

log()    { printf "${BOLD}${BCYAN}  ◆${R}  ${BOLD}%s${R}\n" "$*"; }
ok()     { printf "${BGREEN}  ✓${R}  %s\n" "$*"; }
err()    { printf "${BRED}  ✗${R}  %s\n" "$*" >&2; }
warn()   { printf "${BYELLOW}  ⚠${R}  %s\n" "$*"; }
prompt() { printf "${BOLD}${BCYAN}  ›${R} %s" "$*"; }

# ── helpers ──────────────────────────────────────────────────────────────────

active_workflow() {
  if [[ -f "$ACTIVE_FILE" ]]; then
    tr -d '[:space:]' < "$ACTIVE_FILE"
  else
    echo "(none)"
  fi
}

workflow_description() {
  local name="$1"
  local claude_md="$WORKFLOWS_DIR/$name/CLAUDE.md"
  if [[ -f "$claude_md" ]]; then
    awk '/^# /{found=1; next} found && /[^[:space:]]/{print; exit}' "$claude_md"
  else
    echo "(no description)"
  fi
}

# ── commands ──────────────────────────────────────────────────────────────────

cmd_list() {
  local active
  active=$(active_workflow)

  header "Claude Workflows"

  local found=0
  for dir in "$WORKFLOWS_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    found=1
    local name; name=$(basename "$dir")
    local desc; desc=$(workflow_description "$name")
    local agents skills
    agents=$(find "$dir/agents" -name "*.md" 2>/dev/null | wc -l | tr -d ' ')
    skills=$(find "$dir/skills" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')

    if [[ "$name" == "$active" ]]; then
      printf "  ${BGREEN}●${R}  ${BOLD}%-24s${R}${GRAY}%s agents · %s skills${R}\n" \
        "$name" "$agents" "$skills"
      printf "     ${DIM}%s${R}  ${BGREEN}active${R}\n\n" "$desc"
    else
      printf "  ${GRAY}○${R}  ${BOLD}%-24s${R}${GRAY}%s agents · %s skills${R}\n" \
        "$name" "$agents" "$skills"
      printf "     ${DIM}%s${R}\n\n" "$desc"
    fi
  done

  [[ "$found" -eq 0 ]] && printf "  ${GRAY}No workflows found.${R}\n\n"
}

cmd_status() {
  local active
  active=$(active_workflow)

  header "$active"

  local workflow_dir="$WORKFLOWS_DIR/$active"

  if [[ ! -d "$workflow_dir" ]]; then
    err "Workflow directory not found: $workflow_dir"
    exit 1
  fi

  section "Agents"
  local any_agent=0
  for f in "$workflow_dir/agents"/*.md; do
    [[ -f "$f" ]] || continue
    any_agent=1
    local name; name=$(basename "$f" .md)
    local model; model=$(awk '/^model:/{print $2; exit}' "$f")
    printf "    ${BOLD}%-22s${R}${GRAY}%s${R}\n" "$name" "${model:-(no model)}"
  done
  [[ "$any_agent" -eq 0 ]] && printf "    ${GRAY}(none)${R}\n"

  section "Skills"
  local any_skill=0
  for d in "$workflow_dir/skills"/*/; do
    [[ -d "$d" ]] || continue
    any_skill=1
    printf "    ${BOLD}%s${R}\n" "$(basename "$d")"
  done
  [[ "$any_skill" -eq 0 ]] && printf "    ${GRAY}(none)${R}\n"

  echo ""
}

cmd_switch() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    err "Usage: claude-workflow switch <name>"
    exit 1
  fi

  local workflow_dir="$WORKFLOWS_DIR/$name"
  if [[ ! -d "$workflow_dir" ]]; then
    err "Workflow '$name' not found. Run 'claude-workflow list' to see available workflows."
    exit 1
  fi

  local active
  active=$(active_workflow)

  if [[ "$name" == "$active" ]]; then
    ok "Already on workflow: $name"
    return 0
  fi

  log "Switching  ${GRAY}$active${R}  ${BOLD}${BCYAN}→${R}  ${BOLD}$name${R}"

  # sync workflow files into claude/
  rsync -a --delete \
    --exclude='*.jsonl' \
    --exclude='backups/' \
    --exclude='cache/' \
    --exclude='file-history/' \
    --exclude='history*' \
    --exclude='paste-cache/' \
    --exclude='plans/' \
    --exclude='projects/' \
    --exclude='session-env/' \
    --exclude='sessions/' \
    --exclude='shell-snapshots/' \
    --exclude='telemetry/' \
    "$workflow_dir/" "$CLAUDE_DIR/"

  echo "$name" > "$ACTIVE_FILE"

  ok "Now on ${BOLD}$name${R}"
  cmd_status
}

cmd_new() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    err "Usage: claude-workflow new <name>"
    exit 1
  fi

  local new_dir="$WORKFLOWS_DIR/$name"
  if [[ -d "$new_dir" ]]; then
    err "Workflow '$name' already exists."
    exit 1
  fi

  local active
  active=$(active_workflow)
  local source_dir="$WORKFLOWS_DIR/$active"

  log "Scaffolding ${BOLD}$name${R} from ${GRAY}$active${R}…"

  cp -r "$source_dir" "$new_dir"

  ok "Created workflow: ${BOLD}$name${R}"
  printf "  ${GRAY}Edit: %s/CLAUDE.md${R}\n\n" "$new_dir"
}

cmd_update() {
  log "Updating dotfiles…"
  if git -C "$DOTFILES" pull; then
    ok "Dotfiles updated."
  else
    err "Failed to update dotfiles."
    return 1
  fi
}

# ── interactive selector ─────────────────────────────────────────────────────

# Interactive j/k / arrow-key selector.
# Usage: _select "item1" "item2" ...
# Sets global _SELECTED to the chosen index, or -1 if cancelled (q / ESC / Ctrl-C).
_SELECTED=-1

_select() {
  local items=("$@")
  local current=0
  local count=${#items[@]}
  _SELECTED=-1

  [[ $count -eq 0 ]] && return 0

  printf '\033[?25l'  # hide cursor

  # Initial render
  local i
  for (( i=0; i<count; i++ )); do
    if [[ $i -eq $current ]]; then
      printf "  ${BOLD}${BCYAN}❯${R}  %s\n" "${items[$i]}"
    else
      printf "     %s\n" "${items[$i]}"
    fi
  done

  while true; do
    local key seq
    IFS= read -r -s -n1 key
    if [[ "$key" == $'\033' ]]; then
      IFS= read -r -s -n2 -t 0.05 seq 2>/dev/null || true
      key="${key}${seq}"
    fi

    case "$key" in
      j|$'\033[B') (( current = (current + 1) % count )) || true ;;
      k|$'\033[A') (( current = (current - 1 + count) % count )) || true ;;
      $'\r'|$'\n'|' '|'')
        printf '\033[?25h'
        _SELECTED=$current
        return 0
        ;;
      q|$'\033'|$'\003')
        printf '\033[?25h'
        _SELECTED=-1
        return 0
        ;;
      *) continue ;;
    esac

    # Move cursor up and redraw in-place
    printf '\033[%dA' "$count"
    for (( i=0; i<count; i++ )); do
      printf '\033[2K'
      if [[ $i -eq $current ]]; then
        printf "  ${BOLD}${BCYAN}❯${R}  %s\n" "${items[$i]}"
      else
        printf "     %s\n" "${items[$i]}"
      fi
    done
  done
}

# ── interactive menu ─────────────────────────────────────────────────────────

last_pull_date() {
  local fetch_head="$DOTFILES/.git/FETCH_HEAD"
  if [[ -f "$fetch_head" ]]; then
    date -d "@$(stat -c %Y "$fetch_head")" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "unknown"
  else
    echo "never"
  fi
}

menu_change_workflow() {
  local active
  active=$(active_workflow)

  local workflows=() display_items=()
  for dir in "$WORKFLOWS_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    local wf; wf=$(basename "$dir")
    workflows+=("$wf")
    local desc; desc=$(workflow_description "$wf")
    if [[ "$wf" == "$active" ]]; then
      display_items+=("${BGREEN}$(printf '%-22s' "$wf")${R}  ${DIM}$desc${R}")
    else
      display_items+=("${BOLD}$(printf '%-22s' "$wf")${R}  ${DIM}$desc${R}")
    fi
  done
  display_items+=("${GRAY}cancel${R}")

  printf '\033[2J\033[H'
  section "Select a workflow"
  _select "${display_items[@]}"

  # Last item is "cancel"; -1 means ESC/q
  if [[ $_SELECTED -eq -1 ]] || [[ $_SELECTED -eq ${#workflows[@]} ]]; then
    return
  fi

  local selected="${workflows[$_SELECTED]}"
  if [[ "$selected" == "$active" ]]; then
    ok "Already on: ${BOLD}$selected${R}"
  else
    cmd_switch "$selected"
  fi
}

menu_interactive() {
  local menu_items=(
    "Change workflow"
    "Update dotfiles"
    "Exit"
  )

  while true; do
    local active last_pull
    active=$(active_workflow)
    last_pull=$(last_pull_date)

    printf '\033[2J\033[H'
    header "Claude Workflow Manager"
    printf "  ${GRAY}Active    ${R}${BOLD}%s${R}\n" "$active"
    printf "  ${GRAY}Last pull ${R}%s\n" "$last_pull"
    echo ""
    rule
    echo ""

    _select "${menu_items[@]}"

    case $_SELECTED in
      0) menu_change_workflow ;;
      1) cmd_update ;;
      *) exit 0 ;;  # "Exit" item or cancelled (q/ESC)
    esac
  done
}

# ── dispatch ──────────────────────────────────────────────────────────────────

cmd="${1:-}"
shift || true

case "$cmd" in
  "")     menu_interactive ;;
  list)   cmd_list ;;
  status) cmd_status ;;
  switch) cmd_switch "$@" ;;
  new)    cmd_new "$@" ;;
  *)
    err "Unknown command: $cmd"
    printf "  ${GRAY}Usage: claude-workflow [list|status|switch <name>|new <name>]${R}\n"
    exit 1
    ;;
esac
